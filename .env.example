# Database URL for SQLite (default deployment).
# The database file is created at first run; the directory must be writable.
DATABASE_URL=sqlite:data/deve-sub.db

# Master encryption key for sensitive fields (XChaCha20-Poly1305).
# Generate with: openssl rand -base64 32
# Must be provided in production; never commit the real value.
# DEVE_SUB_MASTER_KEY=

# Server bind address.
# DEVE_SUB_BIND=127.0.0.1:3000

# Log level (tracing).
# RUST_LOG=info,deve_sub=debug
