# Deve Sub environment variables.
#
# These are read by clap's `env` attribute on CLI flags (per-command). The
# JSON config file (--config path.json) is the authoritative source for
# server/security/database settings; env vars only override the CLI flags
# listed below. There is no DATABASE_URL or DEVE_SUB_MASTER_KEY env var —
# the DB path and key path are DEVE_SUB_DB_PATH and DEVE_SUB_KEY_PATH.

# Server bind address (overrides `serve --bind` and the config file).
# Default: 127.0.0.1:8080 (loopback HTTP profile). Set to 0.0.0.0:8080 to
# expose the port (use a reverse proxy with TLS in production).
# DEVE_SUB_BIND=127.0.0.1:8080

# Path to the JSON config file (overrides `serve --config`).
# DEVE_SUB_CONFIG=/etc/deve-sub/config.json

# SQLite database file path (default: data/deve-sub.db).
# DEVE_SUB_DB_PATH=data/deve-sub.db

# Master key file path (default: data/master.key). The file must contain
# exactly 32 raw bytes. Bootstrap with `deve-sub key init --key-path <path>`;
# do NOT use `openssl rand -base64 32` — that produces base64 text, not raw
# bytes, and the key loader will reject it.
# DEVE_SUB_KEY_PATH=data/master.key

# Compiled web frontend dist directory (default: apps/web/dist).
# DEVE_SUB_WEB_DIST_DIR=apps/web/dist

# Update manifest URL (used by `deve-sub update`).
# DEVE_SUB_MANIFEST_URL=https://github.com/Develata/deve-sub/releases/latest/download/manifest.json

# Log level (tracing EnvFilter). Default: info.
RUST_LOG=info,deve_sub=debug
