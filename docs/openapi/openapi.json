{
  "openapi": "3.1.0",
  "info": {
    "title": "Deve Sub API",
    "description": "Self-hosted proxy subscription infrastructure manager",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "summary": "`POST /api/v1/auth/login` — authenticate and create a session.",
        "description": "Returns 401 for unknown user, wrong password, or disabled account — the\nsame error for all three to avoid leaking user existence (AUTH-003).",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "`POST /api/v1/auth/logout` — revoke the current session.",
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Logged out"
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "`GET /api/v1/auth/me` — return the current authenticated user.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/setup": {
      "post": {
        "summary": "`POST /api/v1/auth/setup` — create the first admin user.",
        "description": "Returns 400 for invalid input (empty username, password too short).\nReturns 409 if any users already exist (AUTH-001).",
        "operationId": "setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupAdminRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Admin created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupAdminResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Already initialized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "summary": "`GET /api/v1/users` — list users with cursor pagination (admin only).",
        "operationId": "list_users",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Max users per page (1-100, default 20)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor (last user ULID)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListUsersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not an admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "`POST /api/v1/users` — create a new user (admin only).",
        "description": "Returns 400 for invalid input (empty username, password too short).\nReturns 409 if the username is already taken.",
        "operationId": "create_user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateUserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not an admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Username already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{id}/disable": {
      "post": {
        "summary": "`POST /api/v1/users/{id}/disable` — disable a user and revoke all\ntheir sessions (admin only). AUTH-007.",
        "description": "Returns 409 if the target is the requesting admin's own account\n(self-disable is rejected to prevent lockout).",
        "operationId": "disable_user",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Target user ULID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User disabled"
          },
          "400": {
            "description": "Invalid user id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not an admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Cannot disable yourself",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{id}/force-logout": {
      "post": {
        "summary": "`POST /api/v1/users/{id}/force-logout` — revoke all sessions for a\nuser without disabling the account (admin only). AUTH-010.",
        "operationId": "force_logout",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Target user ULID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sessions revoked"
          },
          "400": {
            "description": "Invalid user id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not an admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "summary": "Liveness probe — returns 200 if the process is alive.",
        "operationId": "health_live",
        "responses": {
          "200": {
            "description": "Service is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthLiveResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness probe — returns 200 if the service is ready to serve requests.",
        "description": "Checks database connectivity. Returns 503 with `degraded` status if the\ndatabase is unreachable.",
        "operationId": "health_ready",
        "responses": {
          "200": {
            "description": "Service is ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service is not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadyResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateUserRequest": {
        "type": "object",
        "description": "Request body for `POST /api/v1/users` (admin-only user creation).",
        "required": [
          "username",
          "password",
          "role"
        ],
        "properties": {
          "password": {
            "type": "string",
            "description": "Plaintext password."
          },
          "role": {
            "$ref": "#/components/schemas/RoleDto",
            "description": "Authorization role."
          },
          "username": {
            "type": "string",
            "description": "Username."
          }
        }
      },
      "CreateUserResponse": {
        "type": "object",
        "description": "Response body for `POST /api/v1/users`.",
        "required": [
          "user"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto",
            "description": "The created user."
          }
        }
      },
      "CurrentUserResponse": {
        "type": "object",
        "description": "Response body for `GET /api/v1/auth/me`.",
        "required": [
          "user"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto",
            "description": "The authenticated user."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error response for auth endpoints.",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Machine-readable error code (e.g. `\"unauthorized\"`, `\"forbidden\"`)."
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message."
          }
        }
      },
      "HealthLiveResponse": {
        "type": "object",
        "description": "Response body for `GET /health/live`.",
        "required": [
          "status",
          "product_name",
          "version"
        ],
        "properties": {
          "product_name": {
            "type": "string",
            "description": "Product display name."
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatusDto",
            "description": "Overall health status."
          },
          "version": {
            "type": "string",
            "description": "Software version."
          }
        }
      },
      "HealthReadyResponse": {
        "type": "object",
        "description": "Response body for `GET /health/ready`.",
        "required": [
          "status",
          "product_name",
          "version"
        ],
        "properties": {
          "product_name": {
            "type": "string",
            "description": "Product display name."
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatusDto",
            "description": "Overall health status."
          },
          "version": {
            "type": "string",
            "description": "Software version."
          }
        }
      },
      "HealthStatusDto": {
        "type": "string",
        "description": "Overall health status reported by health probes.",
        "enum": [
          "healthy",
          "degraded",
          "unhealthy"
        ]
      },
      "ListUsersResponse": {
        "type": "object",
        "description": "Response body for `GET /api/v1/users` (cursor-paginated user list).",
        "required": [
          "users"
        ],
        "properties": {
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cursor for the next page (`None` if no more results)."
          },
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserDto"
            },
            "description": "Users in the current page."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "description": "Request body for `POST /api/v1/auth/login`.",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "description": "Plaintext password."
          },
          "username": {
            "type": "string",
            "description": "Username."
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "description": "Response body for `POST /api/v1/auth/login`.",
        "required": [
          "user"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto",
            "description": "The authenticated user."
          }
        }
      },
      "RoleDto": {
        "type": "string",
        "description": "User role for authorization.",
        "enum": [
          "admin",
          "user"
        ]
      },
      "SetupAdminRequest": {
        "type": "object",
        "description": "Request body for `POST /api/v1/auth/setup` (initial admin creation).",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "description": "Admin password."
          },
          "username": {
            "type": "string",
            "description": "Admin username."
          }
        }
      },
      "SetupAdminResponse": {
        "type": "object",
        "description": "Response body for `POST /api/v1/auth/setup`.",
        "required": [
          "user"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto",
            "description": "The created admin user."
          }
        }
      },
      "UserDto": {
        "type": "object",
        "description": "User information returned by auth and user management endpoints.\n\nNever includes `password_hash` or other secrets.",
        "required": [
          "id",
          "username",
          "role",
          "enabled",
          "traffic_quota",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "description": "Account creation time (ISO 8601 UTC)."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the user can log in."
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional account expiry (ISO 8601 UTC). `None` means no expiry."
          },
          "id": {
            "type": "string",
            "description": "ULID identifier."
          },
          "role": {
            "$ref": "#/components/schemas/RoleDto",
            "description": "Authorization role."
          },
          "traffic_quota": {
            "type": "integer",
            "format": "int64",
            "description": "Traffic quota in bytes (0 = unlimited).",
            "minimum": 0
          },
          "username": {
            "type": "string",
            "description": "Login name."
          }
        }
      }
    }
  }
}
